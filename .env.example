# SmartBank OptiQueue Environment Configuration

# Flask Application Secret Key
SECRET_KEY=bank-queue-system-secure-key-2026-production

# Database Connection (SQLite by default; supports PostgreSQL / MySQL)
# SQLite (Local Development):
DATABASE_URL=sqlite:///bank_queue.db
# PostgreSQL (Production):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/smartbank_queue

# Server Configuration
FLASK_ENV=production
PORT=5000
